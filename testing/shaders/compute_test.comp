#version 450

layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) buffer inBuffer {
    float numbers[];
};

layout(push_constant) uniform PushConstants {
    float factor;
}pc;

void main()
{
    uint gid = gl_GlobalInvocationID.x;

    if (gid >= 128)
    {
        return;
    }
    numbers[gid] *= pc.factor;
}